APP_ADDR=:8080
APP_ENV=development
APP_REQUEST_TIMEOUT=30s
APP_SHUTDOWN_TIMEOUT=10s

# Comma-separated exact browser origins. Do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave all DB_* values empty to start the API without a database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=db_binasiswa
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m
DB_READY_TIMEOUT=2s
